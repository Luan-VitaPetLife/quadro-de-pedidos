# Mandae -- em Configuracoes da conta -> API, dentro do app da Mandae
MANDAE_TOKEN=
MANDAE_CUSTOMER_ID=

# Segredo que a Mandae devolve em cada chamada de webhook (header
# "X-Mandae-Secret"), pra confirmar que a chamada e mesmo dela. Gere um valor
# aleatorio qualquer (ex.: `openssl rand -hex 24`) e cole o mesmo valor aqui
# e no painel da Mandae, em Configuracoes -> API -> Webhooks.
# Prefixo dos codigos de rastreio da Mandae (painel: Configuracoes -> API).
# A operacao usa varias transportadoras; so os codigos com este prefixo sao
# consultados na Mandae -- perguntar pelos outros so gera 404.
MANDAE_PREFIXO_RASTREIO=VITPT

MANDAE_WEBHOOK_SECRET=

# FontesLog -- portal do cliente
FONTESLOG_URL=http://portalfonteslog.ddsinformatica.com.br/
FONTESLOG_LOGIN=
# ASPAS AQUI SE A SENHA TIVER "#". O dotenv trata # como comeco de comentario e
# corta a linha ali: FONTESLOG_SENHA=abc123# chega no codigo como "abc123", e o
# login falha sem dizer por que. Entre aspas ele preserva tudo.
#   errado:  FONTESLOG_SENHA=abc123#
#   certo:   FONTESLOG_SENHA="abc123#"
# (No Railway a variavel vem da plataforma, sem passar pelo dotenv -- la o # vai
# inteiro de qualquer jeito. O problema e so no arquivo local.)
FONTESLOG_SENHA=

# PIN da tela "Entrar na FontesLog", a que aparece no aviso vermelho do quadro.
#
# O quadro e aberto de proposito -- qualquer pessoa do time abre sem senha. A
# senha do portal nao pode herdar isso: servida numa rota aberta, ela estaria
# publicada na internet. Este PIN fecha SO aquela tela.
#
# Vazio = a tela fica fechada, nao aberta. Um segredo que ninguem configurou nao
# pode virar "entra qualquer um".
WMS_LOGIN_PIN=

# De quanto em quanto tempo sincronizar, em minutos (padrao: 120 = 2h).
# Abaixo de 60, qualquer valor serve. De 60 pra cima, use multiplos de 60
# (120 = 2h, 180 = 3h) -- o campo de minutos do cron so vai ate 59.
SYNC_INTERVAL_MINUTES=120

# Porta do servidor web (o Railway define PORT sozinho em producao)
PORT=3000

# Onde gravar o banco SQLite. Em producao (Railway) aponte para o mount
# path do Volume, senao o banco some a cada deploy. Ex.: DATA_DIR=/app/data
# Local: pode deixar vazio, que cai na pasta data/ do projeto.
DATA_DIR=

# Endereco do quadro, usado pelo `npm run testar-pedido` pra mandar um pedido
# real pro quadro e conferir o resultado. Local: http://localhost:3000
BOARD_URL=

# Pedido parado (sem nenhum evento novo) por quantos DIAS UTEIS vira aviso
# (amarelo) e quantos vira problema (vermelho). Conta so dia util: fim de
# semana e feriado nacional nao contam. Pedido ja entregue nunca envelhece.
DIAS_UTEIS_AVISO=5
DIAS_UTEIS_PROBLEMA=10

# SO NO RAILWAY (nao no .env local). Por padrao o Railway da ZERO segundo pro
# processo antigo encerrar antes do SIGKILL -- por isso o encerramento
# gracioso nunca roda e todo deploy vira email de "Deploy Crashed".
# Defina isso nas Variables do Railway, nao aqui:
#   RAILWAY_DEPLOYMENT_DRAINING_SECONDS=15

# De quantos em quantos minutos o quadro bate no portal da FontesLog so pra
# manter a sessao viva. O cookie do portal nao tem validade: quem o mata e o
# servidor deles, por inatividade (~20 minutos). Sem esse pulso, a sessao morre
# entre um ciclo de sincronizacao e outro e o login manual vira rotina diaria.
# Entre 1 e 30; o padrao de 10 da margem folgada. (opcional)
WMS_PULSO_MINUTOS=10

# De quantos em quantos minutos o quadro pergunta ao Bling "o que mudou desde a
# ultima vez?". Essa pergunta e barata (tipicamente zero a tres pedidos), ao
# contrario da varredura de SYNC_INTERVAL_MINUTES, que le a janela inteira.
# Entre 1 e 30; padrao 3. (opcional)
BLING_VIA_RAPIDA_MINUTOS=3
